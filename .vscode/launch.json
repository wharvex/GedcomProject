{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "GEDCOM Viewer - Open File",
            "request": "launch",
            "mainClass": "com.wharvex.gedcom.GedcomViewer",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "java",
            "name": "GEDCOM Viewer - Raw Record Tree",
            "request": "launch",
            "mainClass": "com.wharvex.gedcom.GedcomViewer",
            "cwd": "${workspaceFolder}",
            "args": "fam-tree-example.ged"
        },
        {
            "type": "java",
            "name": "GEDCOM Viewer - Family Tree",
            "request": "launch",
            "mainClass": "com.wharvex.gedcom.GedcomViewer",
            "cwd": "${workspaceFolder}",
            "args": "--view tree fam-tree-example.ged"
        }
    ]
}